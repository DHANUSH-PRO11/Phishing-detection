# Application Environment Configuration
APP_NAME="Phishing URL Detection System"
# In production, set APP_ENV=production and DEBUG=False to disable debug endpoints and API docs
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security & CORS (comma-separated origins; never use wildcard with credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_URL_LENGTH=2048

# Database Configuration
# SQLite local development default:
DATABASE_URL=sqlite:///./backend/data/phishing_detector.db
# PostgreSQL Production Example (Ensure unique strong credentials and rotate defaults):
# POSTGRES_USER=app_db_user
# POSTGRES_PASSWORD=generate_a_strong_random_password_here
# POSTGRES_DB=phishshield
# DATABASE_URL=postgresql://app_db_user:generate_a_strong_random_password_here@localhost:5432/phishshield

# ML Model Configuration
MODEL_DIR=./backend/artifacts
DEFAULT_DECISION_THRESHOLD=0.50
